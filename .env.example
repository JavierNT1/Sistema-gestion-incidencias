# Configuración de ejemplo: reemplazar antes de ejecutar. No usar en producción.
# Local: servidor PostgreSQL accesible desde Ubuntu.
# Compose fija DB_HOST=db, DB_PORT=5432 y DB_NAME=incidencias_db para la API.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incidencias_db
DB_USER=sistemainc_local
DB_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_PROPIA
